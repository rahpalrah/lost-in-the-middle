# Copy this file to ".env" (same folder), fill in YOUR key, and keep ".env" private.
# ".env" is git-ignored. NEVER commit it, paste it in chat, or share it.
#
# Use it with:   longdoc --env-file .env ask contract.pdf "..." --provider openai --model <model>
#            or: LONGDOC_ENV_FILE=.env LONGDOC_PROVIDER=openai longdoc serve
#            or in Python: from longdoc.env import load_env_file; load_env_file(".env")
#
# After creating it on Linux/macOS, restrict who can read it:   chmod 600 .env

# Your OpenAI API key (create one at https://platform.openai.com/api-keys).
OPENAI_API_KEY=

# Which OpenAI chat model to use (any model your account can access).
LONGDOC_MODEL=

# Use OpenAI instead of Claude.
LONGDOC_PROVIDER=openai

# Optional: an OpenAI-compatible server instead of api.openai.com.
# LONGDOC_OPENAI_BASE_URL=

# Optional: limit uploads plus questions per client address per minute.
# LONGDOC_RATE_LIMIT_PER_MIN=30
